# 所有本地缓存和依赖都在此目录下
# 删除整个 QianTong 文件夹即可完全清除

# 本地 Node.js 便携版
.local/node-v*/

# npm 缓存
.local/npm-cache/

# pip 缓存
.local/pip-cache/

# Python 虚拟环境
backend/.venv/

# Node 依赖
frontend/node_modules/

# Python 编译缓存
backend/__pycache__/
backend/**/__pycache__/

# 视频处理临时文件
backend/uploads/
backend/tasks/

# 深度模型权重文件（体积大，需单独下载）
backend/checkpoints/*.pth

# 构建产物
frontend/dist/

# IDE
.vscode/
.idea/

# 环境变量（含本地路径，不应上传）
.env

# npm本地配置（含本地路径，不应上传）
frontend/.npmrc

# 需求文档（私有，不上传）
需求分析.md

# 系统文件
Thumbs.db
.DS_Store
