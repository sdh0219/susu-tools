{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "resolveJsonModule": true,
    "outDir": "./dist/preload",
    "rootDir": "./src/preload",
    "types": ["node"],
    "declaration": false
  },
  "include": ["src/preload/**/*"]
}
