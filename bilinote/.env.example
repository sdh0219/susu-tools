# BiliNote 分发版环境模板（无个人密钥/Cookie）
# 复制为 .env 后使用；模型 Key 请在网页「供应商」里自行配置

BACKEND_PORT=8000
FRONTEND_PORT=3015
# 只监听本机，避免局域网访问到你的 Key/Cookie
BACKEND_HOST=127.0.0.1

VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_SCREENSHOT_BASE_URL=http://127.0.0.1:8000/static/screenshots

ENV=production
STATIC=/static
OUT_DIR=./static/screenshots
IMAGE_BASE_URL=/static/screenshots
DATA_DIR=data

FFMPEG_BIN_PATH=bin/

# B站 Cookie：公开视频无需配置；需要时打开 http://127.0.0.1:8000/cookie.html
# 分发版请保持为空，且不要附带 cookies.txt
COOKIE_FILE=
# COOKIES_FROM_BROWSER=

TRANSCRIBER_TYPE=fast-whisper
WHISPER_MODEL_SIZE=base
